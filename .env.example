NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase — two projects in the "Hoor" org, same schema (supabase/migrations/*).
#   local + staging : ref aqeitbjokejmdcuctcgd (ap-northeast-2)  https://aqeitbjokejmdcuctcgd.supabase.co
#   production      : ref mnxvffifdvcuuuqbtmqy (ap-southeast-1)  https://mnxvffifdvcuuuqbtmqy.supabase.co
# Anon key: Dashboard → Project Settings → API Keys. Service role key: same page, server only, never NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Media (images, video) is served from the project's public "assets" Storage bucket:
#   npm run media:build && npm run media:upload
# Leave unset to derive the bucket URL from NEXT_PUBLIC_SUPABASE_URL; set only to serve media from elsewhere.
NEXT_PUBLIC_ASSET_BASE=
# Billplz (payments). Sandbox account for local + preview, live account for production.
#   API key + X Signature key: Billplz → Settings → API Keys / X Signature Key. Collection ID: Billing → Collections.
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE_KEY=
BILLPLZ_SANDBOX=true
